  "components": {
    "schemas": {
      "SignalDefinition": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 64
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "group": {
            "type": "string",
            "enum": [
              "property",
              "capability",
              "setting"
            ]
          },
          "management": {
            "type": "string",
            "enum": [
              "r",
              "rw",
              "w"
            ]
          },
          "valueType": {
            "type": "string",
            "enum": [
              "NUMBER"
            ]
          },
          "control": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "unit": {
            "type": "string",
            "maxLength": 24
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "enumValues": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "key",
          "title",
          "group",
          "management",
          "valueType",
          "control"
        ]
      },
      "DeviceWrite": {
        "type": "object",
        "additionalProperties": false,
